+function buildPrimaryKey(): Buffer {
+  const dedicated = (config.accountCredentialSecret || '').trim();
+  if (dedicated && dedicated !== WEAK_DEFAULT_SECRET) {
+    return deriveKey(dedicated);
+  }
+  const authToken = (config.authToken || '').trim();
+  if (authToken && authToken !== WEAK_DEFAULT_SECRET) {
+    warnWeakKey('ACCOUNT_CREDENTIAL_SECRET is not set; falling back to AUTH_TOKEN');
+    return deriveKey(authToken);
+  }
+  warnWeakKey('using the built-in default token as the encryption key');
+  return deriveKey(dedicated || authToken || WEAK_DEFAULT_SECRET);
+}
