/* ================================================================
   AI 资源整合网关面板 —— 样式表
   设计原则：
     1. 全部颜色走 CSS 变量，亮/暗主题只切换 :root 一处
     2. 间距用统一的 --s-* 刻度，避免各视图各写各的
     3. 表格统一 .dt（data table）结构，自带搜索/排序/分页
   ================================================================ */

/* ---------- 子页面 sticky 返回栏 ---------- */
.backbar{position:sticky;top:0;z-index:40;
  background:var(--panel);border-bottom:1px solid var(--line);
  margin:-20px -24px 14px;padding:10px 24px;
  display:flex;align-items:center;gap:10px;min-width:0}
.backbar b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  font-size:14px;font-weight:650}
.backbar .btn{flex:0 0 auto}
@media (max-width:1000px){
  .backbar{margin:-16px -14px 12px;padding:10px 14px}
}
@media (max-width:640px){
  .backbar .btn{padding:10px 18px;font-size:14px;font-weight:600}
}

/* ---------- 亮色（默认） ---------- */
:root{
  --bg:#f4f6f9; --panel:#ffffff; --panel-2:#fafbfc; --panel-3:#f2f4f7;
  --line:#e5e8ec; --line2:#d3d8e0;
  --fg:#1a1d23; --muted:#5f6672; --faint:#98a0ac;
  --accent:#2f6fed; --acc:var(--accent);
  --accent-soft:#e9f0ff; --accent-line:#c7d9ff;
  --ok:#0f9d58; --ok-soft:#e7f6ee; --ok-line:#bce5ce;
  --warn:#c2740a; --warn-soft:#fdf3e4; --warn-line:#f4dcb4;
  --err:#dc2626; --err-soft:#fdeaea; --err-line:#f5c8c8;
  --info:#0e8ba8; --info-soft:#e3f5f9; --info-line:#bde6ef;
  --mono:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
  --shadow:0 1px 2px rgba(16,24,40,.05),0 1px 3px rgba(16,24,40,.05);
  --shadow-lg:0 8px 28px rgba(16,24,40,.10);
  --s1:4px; --s2:8px; --s3:12px; --s4:16px; --s5:22px; --s6:30px;
  --r:12px; --r-sm:8px; --r-xs:6px;
}

/* ---------- 暗色 ---------- */
[data-theme="dark"]{
  --bg:#12151b; --panel:#1a1e26; --panel-2:#20252f; --panel-3:#262c37;
  --line:#2b323d; --line2:#3a4350;
  --fg:#e6e9ef; --muted:#a2abba; --faint:#727d8d;
  --accent:#5b8def; --acc:var(--accent);
  --accent-soft:#1b2740; --accent-line:#2d4272;
  --ok:#3fbd77; --ok-soft:#16281f; --ok-line:#255238;
  --warn:#e0a33a; --warn-soft:#2a2114; --warn-line:#4d3c1c;
  --err:#f06a6a; --err-soft:#2c1a1c; --err-line:#542a2c;
  --info:#3bbdd8; --info-soft:#152a30; --info-line:#234a54;
  --shadow:0 1px 2px rgba(0,0,0,.30),0 1px 3px rgba(0,0,0,.24);
  --shadow-lg:0 10px 34px rgba(0,0,0,.45);
}

*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--fg);
  font:14px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  -webkit-font-smoothing:antialiased}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
code,.mono{font-family:var(--mono);font-size:12.5px}

/* ================================ 布局 ================================ */
.wrap{display:flex;min-height:100vh}
.side{width:222px;flex:0 0 222px;background:var(--panel);border-right:1px solid var(--line);
  padding:16px 10px;position:sticky;top:0;height:100vh;overflow-y:auto;overflow-x:hidden}
.brand{display:flex;align-items:center;gap:9px;font-weight:700;font-size:15px;padding:0 8px 14px}
.logo{width:28px;height:28px;border-radius:var(--r-sm);display:grid;place-items:center;color:#fff;
  background:linear-gradient(135deg,var(--accent),#7c5bef);font-size:14px;flex:0 0 auto;
  box-shadow:0 2px 8px rgba(47,111,237,.35)}
.navbtn{display:flex;align-items:center;gap:9px;width:100%;text-align:left;border:0;background:transparent;
  color:var(--muted);padding:7px 10px;border-radius:var(--r-sm);cursor:pointer;font:inherit;
  font-size:13.5px;margin-bottom:1px;position:relative;transition:background .12s,color .12s}
.navbtn:hover{background:var(--panel-3);color:var(--fg)}
.navbtn.on{background:var(--accent-soft);color:var(--accent);font-weight:600}
.navbtn.on::before{content:"";position:absolute;left:-10px;top:6px;bottom:6px;width:3px;
  border-radius:0 3px 3px 0;background:var(--accent)}
.navbtn .ic{width:18px;text-align:center;flex:0 0 auto;font-size:13px}
.navgrp{font-size:11px;color:var(--faint);font-weight:600;letter-spacing:.4px;
  padding:12px 10px 4px;text-transform:uppercase}
.navgrp-toggle{display:flex;align-items:center;justify-content:space-between;cursor:pointer;
  user-select:none}
.navgrp-toggle:hover{color:var(--muted)}
.navgrp-toggle .caret{display:inline-block;font-size:10px;transition:transform .15s ease;opacity:.7}
.navgrp-toggle.open .caret{transform:rotate(90deg)}
.navsub{display:none;padding-left:6px}
.navsub.open{display:block}
.navsub .navbtn{font-size:13px}

.main{flex:1;min-width:0;padding:20px 24px 60px;max-width:1560px}
.hd{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:16px;flex-wrap:wrap}
h1{font-size:20px;margin:0;font-weight:680;letter-spacing:-.2px}
h2{font-size:15px;margin:0;font-weight:650}
h3{font-size:13.5px;margin:0 0 8px;font-weight:650;color:var(--muted)}
.sub{color:var(--muted);font-size:12.5px;margin-top:3px}

/* ================================ 卡片 ================================ */
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);
  padding:var(--s4);box-shadow:var(--shadow);margin-bottom:var(--s4);
  min-width:0;transition:box-shadow .15s ease, border-color .15s ease}
.card:hover{box-shadow:var(--shadow-lg)}
.card>.ch{display:flex;align-items:center;justify-content:space-between;gap:10px;
  margin:-2px 0 12px;flex-wrap:wrap;min-width:0}
.card>.ch b{font-size:14.5px;font-weight:650}
.grid{display:grid;gap:var(--s3)}
.grid>*{min-width:0;align-self:start}
.g2{grid-template-columns:repeat(auto-fit,minmax(330px,1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(224px,1fr))}
.g4{grid-template-columns:repeat(auto-fit,minmax(164px,1fr))}
.g5{grid-template-columns:repeat(auto-fit,minmax(132px,1fr))}

.kpi{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:13px 15px;
  box-shadow:var(--shadow);transition:transform .15s ease, box-shadow .15s ease}
.kpi:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.kpi .lb{color:var(--muted);font-size:12px;margin-bottom:5px}
.kpi .vl{font-size:22px;font-weight:680;letter-spacing:-.4px;line-height:1.2;
  background:linear-gradient(135deg, var(--fg), var(--accent));-webkit-background-clip:text;
  -webkit-text-fill-color:transparent;background-clip:text}
.kpi .ex{color:var(--faint);font-size:11.5px;margin-top:4px;line-height:1.45}

/* ================================ 接入源 ================================ */
.srcbar{display:flex;align-items:center;gap:var(--s5);flex-wrap:wrap;
  background:var(--panel);border:1px solid var(--line);border-radius:var(--r);
  padding:10px 15px;box-shadow:var(--shadow);margin-bottom:var(--s3)}
.srcbar-i{display:flex;flex-direction:column;gap:1px;min-width:0}
.srcbar-i i{font-style:normal;color:var(--muted);font-size:11.5px}
.srcbar-i b{font-size:17px;font-weight:680;letter-spacing:-.3px;line-height:1.25}
.srcbar-i b .faint{font-size:12.5px;font-weight:500}

.srcbar2{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:var(--s3)}
.srcbar2 .q{flex:1 1 200px;min-width:150px;max-width:300px}
.srcseg{display:inline-flex;border:1px solid var(--line2);border-radius:20px;overflow:hidden}
.srcseg button{border:0;background:var(--panel);color:var(--muted);padding:5px 12px;
  cursor:pointer;font:inherit;font-size:12.5px;transition:all .12s}
.srcseg button+button{border-left:1px solid var(--line2)}
.srcseg button:hover{color:var(--accent)}
.srcseg button.on{background:var(--accent);color:#fff}

/* ★ 2026-10-12 终版（new-api 渠道列表范式，用户拍板「照高星项目学」）：
   接入源 = **紧凑列表行**（不再是大卡片网格），详情 = 右侧抽屉 Drawer。 */
/* ★ 2026-10-12（用户拍板「根据缩放不同放不同的列数」）：
   紧凑卡两段式（上行=状态/名称/分类，下行=详情+账号+模型+积分+⟳），
   外层 auto-fill 网格 —— 宽度/缩放一变，列数自动增减；minmax 用 em。 */
.src-list{display:grid;gap:10px;align-items:stretch;
  grid-template-columns:repeat(auto-fill,minmax(25em,1fr))}
.sr-row{display:flex;flex-direction:column;gap:7px;padding:11px 13px;
  background:var(--panel);border:1px solid var(--line);border-radius:10px;
  cursor:pointer;min-width:0;transition:border-color .12s,box-shadow .12s}
.sr-row:hover{border-color:var(--accent);box-shadow:var(--shadow)}
.sr-row.on{border-color:var(--ok-line)}
.sr-row.open{border-color:var(--accent)}
.sr-top{display:flex;align-items:center;gap:8px;min-width:0}
.sr-name{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;line-height:1.3}
.sr-name b{font-size:13px;font-weight:650;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.sr-name .faint{font-size:10.5px;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.sr-cat{flex:0 0 auto;max-width:9em;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.sr-row .sc-f{margin-top:0;padding-top:8px;border-top:1px dashed var(--line2)}
.sr-row .btn{flex:0 0 auto}
/* 右侧抽屉（new-api Drawer 范式）：遮罩 + 滑入面板 */
.sc-mask{position:fixed;inset:0;background:rgba(9,12,18,.42);z-index:79;
  animation:scMaskIn .15s ease}
@keyframes scMaskIn{from{opacity:0}to{opacity:1}}
.sc-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,94vw);
  background:var(--panel);border-left:1px solid var(--line);
  box-shadow:-16px 0 40px rgba(0,0,0,.22);z-index:80;overflow-y:auto;
  padding:16px 18px 28px;animation:scDrIn .18s ease}
@keyframes scDrIn{from{transform:translateX(26px);opacity:0}to{transform:none;opacity:1}}
/* 轮询重绘时禁止重播动画（否则每 2 秒闪一次） */
.sc-drawer.no-anim{animation:none}
.dr-h{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.dr-h b{font-size:14.5px;font-weight:680;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.sc-sect{display:flex;align-items:center;gap:8px;font-size:12px;
  font-weight:650;margin:10px 0 2px;padding-top:8px;
  border-top:1px dashed var(--line2)}
.sc-sect:first-child{border-top:none;padding-top:0;margin-top:0}
.sc-sect i{color:var(--faint);font-style:normal;font-weight:600}
/* 内联登录会话：轻量容器 */
.ls-compact{border:1px solid var(--line2);border-radius:10px;
  padding:10px 12px;margin-top:10px;background:var(--panel-2)}
.sc-h{display:flex;align-items:center;gap:7px;margin-bottom:7px;min-width:0}
.sdot{width:7px;height:7px;border-radius:50%;background:var(--line2);flex:0 0 auto}
.sdot.ok{background:var(--ok);box-shadow:0 0 0 3px var(--ok-soft)}
.sc-n{font-size:13.5px;font-weight:650;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap;min-width:0}
.sc-d{color:var(--faint);font-size:11.5px;line-height:1.5;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
  overflow:hidden;min-height:34px}
.sc-t{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px;min-height:22px;
  align-content:flex-start}
.sc-f{display:flex;align-items:center;gap:8px;margin-top:auto;padding-top:10px}
.sc-ep{flex:1;min-width:0;color:var(--faint);font-size:10.5px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ================================ 元素 ================================ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid var(--line2);
  background:var(--panel);color:var(--fg);padding:6px 13px;border-radius:var(--r-sm);cursor:pointer;
  font:inherit;font-size:13px;white-space:nowrap;transition:border-color .12s,color .12s,box-shadow .12s}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn.pri{background:linear-gradient(135deg, var(--accent), #4d7ff5);
  border-color:var(--accent);color:#fff;
  box-shadow:0 1px 3px rgba(47,111,237,.35)}
.btn.pri:hover{filter:brightness(1.08);color:#fff;
  box-shadow:0 2px 12px rgba(47,111,237,.45);transform:translateY(-1px)}
.btn.sm{padding:3px 9px;font-size:12px}
.btn.dgr:hover{border-color:var(--err);color:var(--err)}
.btn:disabled,.btn[disabled]{opacity:.45;cursor:not-allowed}
.btn[disabled]:hover{border-color:var(--line2);color:var(--fg)}
.btn.gh{background:transparent;border-color:transparent;color:var(--muted)}
.btn.gh:hover{background:var(--panel-3);color:var(--fg);border-color:transparent}

input,select,textarea{width:100%;border:1px solid var(--line2);border-radius:var(--r-sm);
  padding:7px 10px;font:inherit;background:var(--panel);color:var(--fg)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-soft)}
input::placeholder,textarea::placeholder{color:var(--faint)}
label{display:block;font-size:12.5px;color:var(--muted);margin:10px 0 5px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
.row>*{flex:1;min-width:130px;min-width:0}
.row>.n{flex:0 0 auto;min-width:0}
.btnrow{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btnrow>*{flex:0 0 auto}

/* ================================ 表格 ================================ */
.dt{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--panel)}
.dtbar{display:flex;align-items:center;gap:8px;padding:9px 12px;border-bottom:1px solid var(--line);
  background:var(--panel-2);flex-wrap:wrap}
.dtbar input,.dtbar select{width:auto;flex:0 1 auto}
.dtbar .grow{flex:1 1 180px;min-width:140px;max-width:320px}
.dtbar .cnt{color:var(--faint);font-size:12px;margin-left:auto;white-space:nowrap}
.dtbar .sp{width:8px}
.dtw{overflow:auto;max-height:min(62vh,620px)}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);
  vertical-align:top;min-width:0}
th{color:var(--muted);font-weight:600;font-size:12px;background:var(--panel-2);
  position:sticky;top:0;z-index:2;white-space:nowrap}
th.sortable{cursor:pointer;user-select:none}
th.sortable:hover{color:var(--accent)}
th .ar{opacity:.35;margin-left:3px;font-size:10px}
th.on .ar{opacity:1;color:var(--accent)}
tbody tr:hover{background:var(--panel-2)}
tbody tr:last-child td{border-bottom:0}
.dtw th,.scroll th{background:var(--panel-2)}
.dtfoot{display:flex;align-items:center;gap:8px;padding:8px 12px;border-top:1px solid var(--line);
  background:var(--panel-2);font-size:12.5px;color:var(--muted);flex-wrap:wrap}
.dtfoot .sp{flex:1}
.scroll{overflow:auto;max-height:min(62vh,560px);border:1px solid var(--line);border-radius:var(--r-sm)}
.scroll.sm{max-height:300px}

/* ================================ 标记 ================================ */
.tag{display:inline-block;padding:1px 8px;border-radius:20px;font-size:11.5px;
  background:var(--panel-3);color:var(--muted);border:1px solid var(--line)}
.tag.ok{background:var(--ok-soft);color:var(--ok);border-color:var(--ok-line)}
.tag.err{background:var(--err-soft);color:var(--err);border-color:var(--err-line)}
.tag.warn{background:var(--warn-soft);color:var(--warn);border-color:var(--warn-line)}
.tag.info{background:var(--info-soft);color:var(--info);border-color:var(--info-line)}
.tag.acc{background:var(--accent-soft);color:var(--accent);border-color:var(--accent-line)}

.bar{height:7px;border-radius:5px;background:var(--line);overflow:hidden}
.bar>i{display:block;height:100%;background:var(--accent);border-radius:5px}
.bar>i.ok{background:var(--ok)}
.bar>i.warn{background:var(--warn)}
.bar>i.err{background:var(--err)}

/* ================================ 反馈 ================================ */
.empty{color:var(--faint);text-align:center;padding:30px 14px;font-size:13px}
.note{background:var(--accent-soft);border:1px solid var(--accent-line);border-left-width:3px;
  color:var(--accent);
  padding:9px 12px;border-radius:var(--r-sm);font-size:12.5px;margin-bottom:var(--s3)}
.note.warn{background:var(--warn-soft);border-color:var(--warn-line);color:var(--warn)}
.note.err{background:var(--err-soft);border-color:var(--err-line);color:var(--err)}
pre{background:var(--panel-3);border:1px solid var(--line);border-radius:var(--r-sm);padding:11px;
  overflow:auto;font-family:var(--mono);font-size:12px;max-height:340px;margin:0}
.chart{width:100%;height:190px;display:block}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:8px}
.legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:var(--s3)}
.tabs button{border:1px solid var(--line2);background:var(--panel);color:var(--muted);
  padding:5px 13px;border-radius:20px;cursor:pointer;font:inherit;font-size:12.5px;
  transition:all .12s}
.tabs button:hover{border-color:var(--accent);color:var(--accent)}
.tabs button.on{background:var(--accent);border-color:var(--accent);color:#fff;
  box-shadow:0 1px 4px rgba(47,111,237,.35)}
.hidden{display:none !important}
.toast{position:fixed;right:18px;bottom:18px;background:var(--fg);color:var(--bg);padding:10px 15px;
  border-radius:var(--r-sm);font-size:13px;z-index:99;max-width:420px;box-shadow:var(--shadow-lg);
  animation:tin .18s ease-out}
.toast.err{background:var(--err);color:#fff}
.toast.ok{background:var(--ok);color:#fff}
@keyframes tin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.sk{background:linear-gradient(90deg,var(--panel-3) 25%,var(--panel-2) 37%,var(--panel-3) 63%);
  background-size:400% 100%;animation:skm 1.2s ease-in-out infinite;border-radius:var(--r-xs)}
@keyframes skm{0%{background-position:100% 50%}100%{background-position:0 50%}}
.sk.line{height:12px;margin-bottom:8px}
.sk.block{height:76px}

.muted{color:var(--muted)}
.faint{color:var(--faint)}
.right{text-align:right}
.center{text-align:center}
.nowrap{white-space:nowrap}
.mt{margin-top:var(--s3)}
.mb{margin-bottom:var(--s3)}
.mt0{margin-top:0}
.flex{display:flex;gap:var(--s2);align-items:center;flex-wrap:wrap}
.scroll-y{overflow-y:auto}

/* ================================ 响应式 ================================ */
/* ★ 2026-10-12（用户反馈「明显有空间就别收」）：移除 1280px 就把侧边栏
   缩成图标的规则 —— 侧边栏 222px 在 ≥1001px 的视口里空间充足，完整显示；
   需要收起的场景只有 <1000px（自动变顶栏）。 */
@media (max-width:1000px){
  .wrap{flex-direction:column}
  .side{width:100%;flex:none;height:auto;position:static;border-right:0;
    border-bottom:1px solid var(--line);display:flex;align-items:center;gap:4px;
    padding:8px 10px;overflow-x:auto;overflow-y:hidden}
  .brand{width:auto;padding:0 8px 0 0;font-size:14px;flex:0 0 auto}
  .navgrp{display:none}
  .navbtn{width:auto;margin-bottom:0;flex:0 0 auto;white-space:nowrap}
  .navbtn.on::before{display:none}
  .navgrp-toggle{flex:0 0 auto;width:auto;padding:7px 8px}
  .navgrp-toggle .caret{display:none}
  .navsub{display:contents}
  .side .faint{display:none}
  .main{padding:16px 14px 50px;max-width:none}
}
@media (max-width:640px){
  .g2,.g3,.g4,.g5{grid-template-columns:1fr}
  .hd{align-items:flex-start}
  h1{font-size:18px}
}

/* ================================ 模型总表 ================================ */
.gm-group{border-bottom:1px solid var(--line)}
.gm-group:last-of-type{border-bottom:0}
.gm-head{display:flex;align-items:center;gap:9px;padding:11px 14px;cursor:pointer;
  user-select:none;background:var(--panel-2);flex-wrap:wrap;min-width:0}
.gm-head:hover{background:var(--panel-3)}
.gm-head .caret{display:inline-block;font-size:10px;color:var(--faint);
  transition:transform .15s ease;flex:0 0 auto}
.gm-head.open .caret{transform:rotate(90deg)}
.gm-head b{font-size:13.5px;font-weight:650}
.gm-hint{margin-left:auto;font-size:11.5px;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap;max-width:44%}
.gm-rows{border-top:1px solid var(--line)}
/* ★ 2026-10-13：模型总表按接入状态拆两栏（已接入/未接入） */
.gm-sec{border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:12px}
.gm-sec>.gm-head{border-radius:0}
.gm-sec-head{background:var(--panel-3)}
.gm-sec-head b{font-size:14px}
.gm-sec-body>.gm-group:last-child{border-bottom:0}
.gm-id{cursor:pointer;color:var(--fg)}
.gm-id:hover{color:var(--accent);text-decoration:underline}
.gm-desc{max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.dtw::-webkit-scrollbar,.side::-webkit-scrollbar,.scroll::-webkit-scrollbar,
pre::-webkit-scrollbar{width:8px;height:8px}
.dtw::-webkit-scrollbar-thumb,.side::-webkit-scrollbar-thumb,
.scroll::-webkit-scrollbar-thumb,pre::-webkit-scrollbar-thumb{
  background:var(--line2);border-radius:6px}
.dtw::-webkit-scrollbar-thumb:hover,.side::-webkit-scrollbar-thumb:hover,
.scroll::-webkit-scrollbar-thumb:hover,pre::-webkit-scrollbar-thumb:hover{
  background:var(--faint)}
.dtw::-webkit-scrollbar-track,.side::-webkit-scrollbar-track,
.scroll::-webkit-scrollbar-track,pre::-webkit-scrollbar-track{background:transparent}

.btn:focus-visible,input:focus-visible,select:focus-visible,
textarea:focus-visible,.navbtn:focus-visible{outline:2px solid var(--accent);
  outline-offset:1px}

::selection{background:var(--accent-soft);color:var(--accent)}

/* ---------- 接入源分组 ---------- */
.src-group{margin-bottom:16px}
.src-group-head{
  display:flex;align-items:center;gap:8px;
  padding:10px 12px;
  background:var(--panel-2);
  border:1px solid var(--line);
  border-radius:8px;
  cursor:pointer;
  margin-bottom:8px;
  font-size:14px;
}
.src-group-head:hover{background:var(--panel-3)}
.src-group-head .caret{font-size:11px;color:var(--faint)}
.src-group-head b{font-weight:650}
.src-group-head .tag{margin-left:auto}
/* ================================================================
   2026-10-07 新增：接入源卡片（指标行 + 展开区）+ 任务中心卡片
   照 dsh-our-free-model 的来源卡片：一眼看清「账号 n / 模型 n」，
   账号与模型清单可就地展开，模型行带启用开关。
   ================================================================ */
/* ★ 2026-10-12（用户拍板）：分类改左侧竖排——「全部」固定顶部，其余默认
   只露三行（em 单位，缩放友好），展开后列表内滚动；窄屏自动回横排。 */
.src-body{display:flex;gap:14px;align-items:flex-start}
.src-cats-v{flex:0 0 11em;display:flex;flex-direction:column;gap:4px;
  position:sticky;top:64px}
.src-main{flex:1 1 auto;min-width:0}  /* ★ 修：右侧空旷的根因（少了 flex:1） */
.src-cats-v button{display:flex;justify-content:space-between;align-items:center;
  gap:6px;width:100%;border:1px solid transparent;background:transparent;
  color:var(--fg);border-radius:var(--r-sm);padding:.45em .7em;
  font-size:12.5px;cursor:pointer;text-align:left}
.src-cats-v button:hover{background:var(--panel-3)}
.src-cats-v button.on{background:var(--accent);border-color:var(--accent);color:#fff}
.src-cats-v button .faint{opacity:.85;font-size:11px}
.src-cats-v button.on .faint{color:#e8f0ff}
.src-cats-v .cn{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.src-cats-v .cat-list{display:flex;flex-direction:column;gap:2px;
  max-height:calc(3 * 2.5em);overflow:hidden;
  transition:max-height .15s ease}
.src-cats-v .cat-list.open{max-height:16em;overflow-y:auto}
.src-cats-v .cat-toggle{color:var(--muted);font-size:11.5px;justify-content:center}
@media (max-width:860px){
  .src-body{flex-direction:column}
  .src-cats-v{flex:0 0 auto;width:100%;position:static}
  .src-cats-v .cat-list{flex-direction:row;flex-wrap:wrap;max-height:none}
}
.sc2{display:flex;flex-direction:column}
.sc2 .sc-h{cursor:pointer;align-items:center}
/* ★ 2026-10-12：统一操作栏的统计文本 */
.sc-stat{font-size:12px;color:var(--muted);display:inline-flex;gap:4px;
  align-items:baseline;flex:0 0 auto;white-space:nowrap}
.sc-stat b{color:var(--fg);font-size:12.5px}
.sc-metrics .m{display:flex;align-items:baseline;gap:5px;font-size:11.5px}
.sc-metrics .m i{color:var(--faint);font-style:normal}
.sc-metrics .m b{font-size:13px;color:var(--fg)}
.sc-sub{
  margin-top:8px;border-top:1px dashed var(--line2);padding-top:6px;
  max-height:210px;overflow:auto;
}
.sc-row{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:12px}
.sc-row .mono{
  flex:0 1 auto;max-width:46%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.sc-row .faint{
  flex:1 1 auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.sc-row .btn{margin-left:auto;flex:0 0 auto}

.okc{color:var(--ok)}
.warnc{color:var(--warn)}
.tk-meta{
  display:flex;flex-wrap:wrap;gap:4px 14px;font-size:11.5px;
  color:var(--muted);margin:6px 0 2px;
}
.tk-meta b{color:var(--fg)}
.tk-last{
  font-size:11.5px;color:var(--muted);min-height:16px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.tk-last.err{color:var(--err)}
.tk-acts{
  display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;
  border-top:1px dashed var(--line2);padding-top:8px;
}
