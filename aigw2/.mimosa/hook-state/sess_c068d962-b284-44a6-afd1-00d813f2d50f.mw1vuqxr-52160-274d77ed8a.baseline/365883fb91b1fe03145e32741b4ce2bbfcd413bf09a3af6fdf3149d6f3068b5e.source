// 验证 Accio 跳转登录界面已生效
const { spawn } = require('child_process');
const CHROME = 'C:/Program Files/Google/Chrome/Application/chrome.exe';
const PORT = 9336;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function main() {
  const proc = spawn(CHROME, ['--headless=new', `--remote-debugging-port=${PORT}`,
    '--user-data-dir=C:/Windows/Temp/_aigw_acc', '--no-first-run', '--disable-gpu',
    '--window-size=1440,980', 'about:blank'], { stdio: 'ignore' });
  let t = null;
  for (let i = 0; i < 60; i++) {
    try { t = await (await fetch(`http://127.0.0.1:${PORT}/json/list`)).json(); if (t.length) break; } catch (_) {}
    await sleep(250);
  }
  const ws = new WebSocket(t.find((x) => x.type === 'page').webSocketDebuggerUrl);
  let id = 0; const pend = new Map();
  ws.addEventListener('message', (e) => { const m = JSON.parse(e.data); if (m.id && pend.has(m.id)) { pend.get(m.id)(m); pend.delete(m.id); } });
  await new Promise((r) => ws.addEventListener('open', r));
  const send = (m, p) => new Promise((r) => { const i = ++id; pend.set(i, r); ws.send(JSON.stringify({ id: i, method: m, params: p || {} })); });
  const ev = async (e) => { const r = await send('Runtime.evaluate', { expression: e, returnByValue: true, awaitPromise: true }); if (r.result && r.result.exceptionDetails) throw new Error(r.result.exceptionDetails.text); return r.result && r.result.result ? r.result.result.value : undefined; };

  await send('Page.enable'); await send('Runtime.enable');
  await send('Page.navigate', { url: 'http://127.0.0.1:8800/#/sources' });
  await sleep(3500);

  let fails = 0;
  const check = (n, ok, extra) => { if (ok) console.log(`  ✓ ${n}${extra ? '  ' + extra : ''}`); else { fails++; console.log(`  ✗ ${n}${extra ? '  ' + extra : ''}`); } };

  console.log('\nAccio 登录界面：');
  const r = await ev(`(async function(){
    const rows = (await (await fetch('/api/platforms')).json()).rows || [];
    const p = rows.find(x => x.id === 'apk-accio');
    if (!p) return JSON.stringify({err:'平台不存在'});
    const box = document.createElement('div');
    box.innerHTML = srcDetail(p);
    const txt = box.textContent.replace(/\\s+/g,' ');
    return JSON.stringify({
      hasBtn: /打开授权页/.test(txt),
      hasPkce: /PKCE/.test(txt),
      hasPort: /51123/.test(txt),
      hasSliderWarn: /滑块验证/.test(txt),
      badge: authLabelOf(p),
      loginUi: LOGIN_UI_OF[p.id] || '(默认)',
      noPasteApiKey: !/去官网申请/.test(txt),
      txt: txt.slice(0, 400),
    });
  })()`);
  const j = JSON.parse(r || '{}');
  if (j.err) { console.log('  ✗ ' + j.err); fails++; }
  else {
    check('有「打开授权页」按钮', j.hasBtn === true);
    check('说明里提到 PKCE', j.hasPkce === true);
    check('说明里提到 51123 回调', j.hasPort === true);
    check('有滑块验证风险警示', j.hasSliderWarn === true);
    check('徽章=跳转登录', j.badge === '跳转登录', j.badge);
    check('走 pkce 界面族', j.loginUi === 'pkce', j.loginUi);
    check('不再说「去官网申请」', j.noPasteApiKey === true);
  }

  console.log('\n其它客户端平台仍是粘贴（应如此）：');
  const r2 = await ev(`(async function(){
    const rows = (await (await fetch('/api/platforms')).json()).rows || [];
    const out = {};
    for (const pid of ['apk-autoclaw','apk-orcaterm','sub-copilot']) {
      const p = rows.find(x => x.id === pid);
      if (!p) { out[pid] = 'missing'; continue; }
      const box = document.createElement('div');
      box.innerHTML = srcDetail(p);
      out[pid] = authLabelOf(p) + ' | 申请字样:' + (/去官网申请/.test(box.textContent));
    }
    return JSON.stringify(out);
  })()`);
  const j2 = JSON.parse(r2 || '{}');
  for (const [k, v] of Object.entries(j2)) {
    const ok = !String(v).includes('申请字样:true');
    check(`${k} 不再谎称申请 ${ok ? '' : v}`, ok);
  }

  // 截图
  await ev(`(async function(){
    const rows = (await (await fetch('/api/platforms')).json()).rows || [];
    const p = rows.find(x => x.id === 'apk-accio');
    const col = document.querySelector('.src-detail-col');
    if (col && p) col.innerHTML = srcDetail(p);
  })()`);
  await sleep(600);
  const shot = await send('Page.captureScreenshot', { format: 'png' });
  if (shot.data) {
    require('fs').writeFileSync('C:/Users/liang.zhao/Downloads/网关项目/_accio_login.png', Buffer.from(shot.data, 'base64'));
    console.log('\n  ✓ 截图 _accio_login.png');
  }

  console.log('\n' + (fails ? `✗ ${fails} 项失败` : '✓ 全部通过'));
  ws.close(); proc.kill(); process.exit(fails ? 1 : 0);
}
main().catch((e) => { console.error('✗', e.message); process.exit(1); });
