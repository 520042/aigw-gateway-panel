// 一次性验证脚本（不入库）：给 app.js 造最小 DOM 桩，跑通弹窗骨架与关键渲染函数。
// 用法：bun _harness.js
const fs = require('fs');
const src = fs.readFileSync('web/app.js', 'utf8');

// ── 最小 DOM 桩 ──────────────────────────────────────────────
const listeners = {};
const mkEl = (tag = 'div') => {
  const el = {
    tagName: tag.toUpperCase(), style: {}, dataset: {}, children: [],
    innerHTML: '', textContent: '', className: '', value: '',
    clientHeight: 420, scrollTop: 0, scrollHeight: 0,
    classList: { add() {}, remove() {}, toggle() {}, contains() { return false; } },
    setAttribute() {}, getAttribute() { return null; }, hasAttribute() { return false; },
    appendChild(c) { this.children.push(c); return c; },
    insertAdjacentHTML(_p, h) { this.innerHTML += h; },
    addEventListener() {}, removeEventListener() {},
    querySelector() { return null; }, querySelectorAll() { return []; },
    closest() { return null; }, remove() {}, focus() {}, click() {},
  };
  return el;
};
const masks = [];
global.document = {
  body: mkEl('body'),
  documentElement: mkEl('html'),
  addEventListener(t, f) { (listeners[t] = listeners[t] || []).push(f); },
  createElement(t) { return mkEl(t); },
  getElementById() { return null; },
  querySelector() { return null; },
  querySelectorAll(sel) { return sel === '.modal-mask' ? masks.slice() : []; },
};
global.window = { addEventListener() {}, location: { href: 'http://127.0.0.1:8800/' } };
global.location = global.window.location;
global.localStorage = { getItem: () => null, setItem() {}, removeItem() {} };
global.history = { replaceState() {} };
global.navigator = { clipboard: { writeText() {} } };
global.fetch = async () => ({ ok: true, status: 200, json: async () => ({}), text: async () => '' });
global.alert = () => {};
global.confirm = () => true;
global.requestAnimationFrame = (f) => setTimeout(f, 0);

// ── 执行 app.js（返回它声明的函数，供下面直接调） ──────────────
const sandbox = new Function(
  'document', 'window', 'location', 'localStorage', 'history', 'navigator',
  'fetch', 'alert', 'confirm', 'requestAnimationFrame',
  src + '\n;return { modalShell, esc, att, safeUrl, donutSVG, nfmt: (typeof nfmt === "function" ? nfmt : null) };'
);
let api;
try {
  api = sandbox(global.document, global.window, global.location, global.localStorage,
    global.history, global.navigator, global.fetch, global.alert, global.confirm, global.requestAnimationFrame);
} catch (e) {
  console.error('✗ app.js 顶层执行抛错：', e && e.message);
  process.exit(1);
}
if (!api) { console.error('✗ 没拿到导出'); process.exit(1); }

let fails = 0;
const eq = (name, got, want) => {
  const ok = got === want;
  if (!ok) { fails++; console.log('  ✗', name, '\n     got:', JSON.stringify(got), '\n    want:', JSON.stringify(want)); }
  else console.log('  ✓', name);
};
const has = (name, hay, needle) => {
  const ok = String(hay).includes(needle);
  if (!ok) { fails++; console.log('  ✗', name, '\n     缺:', needle, '\n     在:', String(hay).slice(0, 300)); }
  else console.log('  ✓', name);
};
const hasNot = (name, hay, needle) => {
  const ok = !String(hay).includes(needle);
  if (!ok) { fails++; console.log('  ✗', name, '\n     不该有:', needle); }
  else console.log('  ✓', name);
};

console.log('\n[1] modalShell 基本骨架');
const m = api.modalShell('标题', '<p>正文</p>');
has('有遮罩', m, 'class="modal-mask"');
has('有标题栏', m, 'class="modal-hd"');
has('有 ✕', m, 'class="x"');
has('有单个 modal-bd', m, 'class="modal-bd"');
eq('modal-bd 只出现一次', (m.match(/modal-bd/g) || []).length, 1);
has('带 data-close', m, 'data-close=');
hasNot('普通弹窗无 noclose', m, 'data-noclose');

console.log('\n[2] 抽屉形态 + 自定义关闭动作');
const d = api.modalShell('抽屉', 'x', { drawer: true, id: 'srcDrawer', onMask: 'A', close: 'B()' });
has('drawer 类', d, 'modal drawer');
has('id 落地', d, 'id="srcDrawer"');
has('遮罩动作', d, 'if(event.target===this){A}');
has('✕ 用自定义关闭', d, "onclick=\"B()\"");
has('data-close 记录 B()', d, 'data-close="B()"');

console.log('\n[3] closable:false 不给关');
const nc = api.modalShell('必须处理', 'x', { closable: false });
hasNot('无 ✕', nc, 'class="x"');
has('带 noclose 标记', nc, 'data-noclose="1"');
hasNot('无 data-close', nc, 'data-close=');

console.log('\n[4] 关闭表达式里的引号不会撑破属性');
// 属性用双引号包，所以表达式里的单引号是安全的；真正的风险是表达式自带双引号。
const q = api.modalShell('t', 'x', { close: 'window.say("bye")' });
has('双引号被转义', q, 'data-close="window.say(&quot;bye&quot;)"');
hasNot('属性没被提前闭合', q, 'data-close="window.say("bye")"');
// 默认关闭动作（只有单引号）保持原样，可读性不受影响
const q2 = api.modalShell('t', 'x');
has('默认动作原样保留', q2, "data-close=\"this.closest('.modal-mask').remove()\"");

console.log('\n[5] 转义函数');
eq('esc 尖括号', api.esc('<a&">'), '&lt;a&amp;&quot;&gt;');
eq('att 转义单引号', api.att("a'b"), 'a\\&#39;b');
eq('safeUrl 拦 javascript:', api.safeUrl('javascript://x/%0Aalert(1)'), '');
eq('safeUrl 放行 https', api.safeUrl('https://a.com/x'), 'https://a.com/x');

console.log('\n[6] ESC 监听已注册');
eq('挂了 keydown', (listeners.keydown || []).length, 1);

// ESC 行为：没有弹窗时不应抛错
try {
  listeners.keydown[0]({ key: 'Escape', target: global.document.body, preventDefault() {} });
  console.log('  ✓ 无弹窗时 ESC 安全');
} catch (e) {
  fails++; console.log('  ✗ 无弹窗时 ESC 抛错：', e.message);
}

console.log('\n' + (fails ? `✗ ${fails} 项失败` : '✓ 全部通过'));
process.exit(fails ? 1 : 0);
