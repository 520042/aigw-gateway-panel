// 验证「凭据来源」提示文案：每个平台显示的是不是它真实需要的东西。
// 用法：bun _logincheck.js
const { spawn } = require('child_process');
const CHROME = 'C:/Program Files/Google/Chrome/Application/chrome.exe';
const PORT = 9334;
const BASE = 'http://127.0.0.1:8800';
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function main() {
  const proc = spawn(CHROME, ['--headless=new', `--remote-debugging-port=${PORT}`,
    '--user-data-dir=C:/Windows/Temp/_aigw_login', '--no-first-run', '--disable-gpu',
    '--window-size=1440,980', 'about:blank'], { stdio: 'ignore' });

  let targets = null;
  for (let i = 0; i < 60; i++) {
    try { const r = await fetch(`http://127.0.0.1:${PORT}/json/list`); targets = await r.json(); if (targets.length) break; } catch (_) {}
    await sleep(250);
  }
  const ws = new WebSocket(targets.find((t) => t.type === 'page').webSocketDebuggerUrl);
  let id = 0; const pending = new Map();
  ws.addEventListener('message', (ev) => {
    const m = JSON.parse(ev.data);
    if (m.id && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); }
  });
  await new Promise((res) => ws.addEventListener('open', res));
  const send = (method, params) => new Promise((res) => {
    const myId = ++id; pending.set(myId, (m) => res(m.result || m.error));
    ws.send(JSON.stringify({ id: myId, method, params: params || {} }));
  });
  const evalJs = async (expr) => {
    const r = await send('Runtime.evaluate', { expression: expr, returnByValue: true, awaitPromise: true });
    if (r && r.exceptionDetails) throw new Error(r.exceptionDetails.text);
    return r && r.result ? r.result.value : undefined;
  };

  await send('Page.enable'); await send('Runtime.enable');
  await send('Page.navigate', { url: BASE + '/#/sources' });
  await sleep(3000);

  const fails = [];
  const check = (n, ok, extra) => {
    if (ok) console.log(`  ✓ ${n}${extra ? '  ' + extra : ''}`);
    else { fails.push(n); console.log(`  ✗ ${n}${extra ? '  ' + extra : ''}`); }
  };

  // 要检查的平台：用户点名的 + 同类无专门分支的
  const cases = [
    // Accio 已从「粘贴客户端 token」升级为真正的 PKCE 跳转登录，
    // 断言随之改成「必须出现打开授权页」。分类仍是 client（客户端反代）。
    ['apk-accio', 'client', '打开授权页', false],
    ['apk-autoclaw', 'client', '客户端 accessToken', false],
    ['apk-autoclaw-intl', 'client', '客户端 accessToken', false],
    ['apk-qwenwork', 'client', '登录态 JWT', false],
    ['sub-copilot', 'client', 'Copilot access token', false],
    ['sub-factory', 'client', 'WorkOS OAuth access token', false],
    ['sub-zed', 'client', 'Zed 账号 access token', false],
    ['sub-zcode', 'client', '订阅登录态 access_token', false],
    // 真正的开放平台：必须仍然说「申请 Key」
    ['api-deepseek', 'openapi', '申请', true],
    ['api-moonshot', 'openapi', '申请', true],
    ['api-siliconflow', 'openapi', '申请', true],
  ];

  console.log('\n逐个平台检查登录区文案：\n');
  for (const [pid, expectSrc, expectWord, wantApply] of cases) {
    const r = await evalJs(`(async function(){
      const rows = (await (await fetch('/api/platforms')).json()).rows || [];
      const p = rows.find(x => x.id === ${JSON.stringify(pid)});
      if (!p) return JSON.stringify({err:'平台不存在'});
      const el = document.getElementById('view');
      // 直接调渲染函数：比在列表里滚动找行稳
      const html = srcDetail(p);
      const box = document.createElement('div');
      box.innerHTML = html;
      const txt = box.textContent.replace(/\\s+/g,' ');
      return JSON.stringify({txt: txt.slice(0, 600), src: credSourceOf(p)});
    })()`);
    let j; try { j = JSON.parse(r); } catch (_) { j = { err: 'parse' }; }
    if (j.err) { check(`${pid}`, false, j.err); continue; }

    // 分类正确
    check(`${pid} 分类=${j.src}`, j.src === expectSrc, j.src !== expectSrc ? `期望 ${expectSrc}` : '');
    // 关键词
    const hasWord = j.txt.includes(expectWord);
    check(`${pid} 提到「${expectWord}」`, hasWord);
    // 客户端/订阅平台不应出现「申请」字样（除非是提示去用 api-* 通道）
    if (!wantApply) {
      const bogus = /去官网申请|还没有 Key？.*申请/.test(j.txt);
      check(`${pid} 不再谎称「去官网申请」`, !bogus);
    } else {
      check(`${pid} 保留了「申请」指引`, /申请/.test(j.txt));
    }
    console.log('');
  }

  // 全局扫描：不该有任何平台在 client/sub 分类下仍显示「去官网申请」
  console.log('全局扫描（全部 api_key 平台）：');
  const scan = await evalJs(`(async function(){
    const rows = (await (await fetch('/api/platforms')).json()).rows || [];
    const bad = [];
    for (const p of rows) {
      if (p.auth !== 'api_key') continue;
      const s = credSourceOf(p);
      if (s === 'openapi') continue;
      const box = document.createElement('div');
      box.innerHTML = srcDetail(p);
      const txt = box.textContent.replace(/\\s+/g,' ');
      if (/去官网申请/.test(txt)) bad.push(p.id + ' [' + s + ']');
    }
    return JSON.stringify(bad);
  })()`);
  const badList = JSON.parse(scan || '[]');
  check('无非开放平台谎称可申请 Key', badList.length === 0, badList.join(', '));

  // 截图三个代表平台
  console.log('\n截图：');
  for (const [pid, label] of [['apk-accio', 'accio'], ['apk-autoclaw', 'autoclaw'], ['sub-copilot', 'copilot']]) {
    await evalJs(`(async function(){
      const rows = (await (await fetch('/api/platforms')).json()).rows || [];
      const p = rows.find(x => x.id === ${JSON.stringify(pid)});
      const col = document.querySelector('.src-detail-col');
      if (col && p) col.innerHTML = srcDetail(p);
    })()`);
    await sleep(500);
    const shot = await send('Page.captureScreenshot', { format: 'png' });
    if (shot && shot.data) {
      require('fs').writeFileSync(`C:/Users/liang.zhao/Downloads/网关项目/_login_${label}.png`, Buffer.from(shot.data, 'base64'));
      console.log(`  ✓ _login_${label}.png`);
    }
  }

  console.log('\n' + (fails.length ? `✗ ${fails.length} 项失败：${fails.join(' | ')}` : '✓ 全部通过'));
  ws.close(); proc.kill(); process.exit(fails.length ? 1 : 0);
}
main().catch((e) => { console.error('✗', e.message); process.exit(1); });
