// 一次性真实浏览器验证（不入库）：起 Chrome headless + CDP，逐页检查渲染/弹窗/ESC/DOM 节点数。
// 用法：bun _e2e.js
const { spawn } = require('child_process');
const CHROME = 'C:/Program Files/Google/Chrome/Application/chrome.exe';
const PORT = 9333;
const BASE = 'http://127.0.0.1:8801';

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function httpJson(path) {
  const r = await fetch(`http://127.0.0.1:${PORT}${path}`);
  return r.json();
}

async function main() {
  const proc = spawn(CHROME, [
    '--headless=new', `--remote-debugging-port=${PORT}`,
    '--user-data-dir=C:/Windows/Temp/_aigw_e2e', '--no-first-run',
    '--disable-gpu', '--window-size=1440,900', 'about:blank',
  ], { stdio: 'ignore' });

  // 等 devtools 起来
  let targets = null;
  for (let i = 0; i < 60; i++) {
    try { targets = await httpJson('/json/list'); if (targets && targets.length) break; } catch (_) {}
    await sleep(250);
  }
  if (!targets || !targets.length) { console.error('✗ Chrome 未就绪'); proc.kill(); process.exit(1); }

  const ws = new WebSocket(targets.find((t) => t.type === 'page').webSocketDebuggerUrl);
  let id = 0;
  const pending = new Map();
  const events = [];
  ws.addEventListener('message', (ev) => {
    const m = JSON.parse(ev.data);
    if (m.id && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); }
    else if (m.method) events.push(m);
  });
  await new Promise((res, rej) => { ws.addEventListener('open', res); ws.addEventListener('error', rej); });

  const send = (method, params) => new Promise((res) => {
    const myId = ++id;
    pending.set(myId, (m) => res(m.result || m.error));
    ws.send(JSON.stringify({ id: myId, method, params: params || {} }));
  });

  const evalJs = async (expr, awaitPromise = true) => {
    const r = await send('Runtime.evaluate', {
      expression: expr, returnByValue: true, awaitPromise, expression_note: 'e2e',
    });
    if (r && r.exceptionDetails) throw new Error(r.exceptionDetails.text + ' :: ' + (r.exceptionDetails.exception || {}).description);
    return r && r.result ? r.result.value : undefined;
  };

  await send('Page.enable');
  await send('Runtime.enable');

  const fails = [];
  const check = (name, ok, extra) => {
    if (ok) console.log(`  ✓ ${name}${extra ? '  ' + extra : ''}`);
    else { fails.push(name); console.log(`  ✗ ${name}${extra ? '  ' + extra : ''}`); }
  };

  console.log('\n[1] 加载首页');
  await send('Page.navigate', { url: BASE + '/' });
  await sleep(2500);
  const docState = await evalJs('document.readyState');
  check('readyState 完成', docState === 'complete', docState);

  // 收集 JS 错误
  const jsErr = events.filter((e) => e.method === 'Runtime.exceptionThrown');
  check('无未捕获 JS 异常', jsErr.length === 0, jsErr.length ? jsErr[0].params.exceptionDetails.text : '');

  console.log('\n[2] 逐视图渲染 + DOM 节点数');
  const views = await evalJs('JSON.stringify((window.__ROUTES||[]).length ? window.__ROUTES : [])').catch(() => '[]');
  const routes = [['overview', '总览'], ['sources', '接入源'], ['accounts', '模型与用量'],
                  ['usage', '用量明细'], ['logs', '日志'], ['runtime', '运行配置'], ['about', '关于']];
  const domCounts = {};
  // 各视图渲染完成时间不同：about 要等 update-check（外部网络 ~1s）+ loadKeys + loadCombos，
  // 实测 5s 才稳定。给每页留够时间，否则会把「还在加载」误判成渲染失败。
  const waitFor = { about: 6500, usage: 2200, sources: 2200, accounts: 2000 };
  for (const [hash, label] of routes) {
    await evalJs(`location.hash = '#/${hash}'`);
    await sleep(waitFor[hash] || 1400);
    const n = await evalJs('document.getElementById("view") ? document.getElementById("view").querySelectorAll("*").length : -1');
    const hasContent = await evalJs('(document.getElementById("view")||{}).innerHTML ? document.getElementById("view").innerHTML.length : 0');
    domCounts[label] = n;
    check(`${label} 渲染`, n > 5 && hasContent > 100, `${n} 个节点`);
  }

  console.log('\n[3] 弹窗：ESC 与遮罩关闭');
  await evalJs(`location.hash = '#/overview'`); await sleep(1500);
  // 直接调取数器函数，比按文案找按钮稳（按钮在页头，文案会改）
  const opened = await evalJs(`(async function(){
    if (typeof showGatewayInfo !== 'function') return 'no-fn';
    await showGatewayInfo();
    return document.querySelectorAll('.modal-mask').length;
  })()`);
  check('能打开弹窗', opened === 1, String(opened));

  // ESC 关闭
  const afterEsc = await evalJs(`(function(){
    document.dispatchEvent(new KeyboardEvent('keydown', {key:'Escape', bubbles:true}));
    return document.querySelectorAll('.modal-mask').length;
  })()`);
  check('ESC 能关闭弹窗', afterEsc === 0, `剩 ${afterEsc} 个`);

  // 再开一次，点遮罩关闭
  const maskClose = await evalJs(`(async function(){
    await showGatewayInfo();
    const mask = document.querySelector('.modal-mask');
    if (!mask) return 'no-mask';
    mask.dispatchEvent(new MouseEvent('click', {bubbles:true}));
    return document.querySelectorAll('.modal-mask').length;
  })()`);
  check('点遮罩能关闭弹窗', maskClose === 0, `剩 ${maskClose} 个`);

  console.log('\n[4] 弹窗内点内容区不该关');
  const innerClick = await evalJs(`(async function(){
    await showGatewayInfo();
    const bd = document.querySelector('.modal-bd');
    if (!bd) return 'no-body';
    bd.dispatchEvent(new MouseEvent('click', {bubbles:true}));
    const n = document.querySelectorAll('.modal-mask').length;
    document.querySelectorAll('.modal-mask').forEach(m => m.remove());
    return n;
  })()`);
  check('点内容区不关闭', innerClick === 1, `剩 ${innerClick} 个`);

  console.log('\n[5] 语义色类生效');
  const colors = await evalJs(`(function(){
    const out = {};
    const mk = (cls, txt) => { const d=document.createElement('span'); d.className=cls; d.textContent=txt; document.body.appendChild(d); const c=getComputedStyle(d).color; d.remove(); return c; };
    out.ok = mk('c-ok','x'); out.err = mk('c-err','x'); out.warn = mk('c-warn','x');
    out.warnnote = (function(){ const d=document.createElement('div'); d.className='note warnnote'; document.body.appendChild(d); const c=getComputedStyle(d).backgroundColor; d.remove(); return c; })();
    return JSON.stringify(out);
  })()`);
  const cj = JSON.parse(colors || '{}');
  check('c-ok 有颜色', !!cj.ok && cj.ok !== 'rgb(22, 24, 29)', cj.ok);
  check('c-err 有颜色', !!cj.err, cj.err);
  check('c-warn 有颜色', !!cj.warn, cj.warn);
  check('warnnote 有底纹', !!cj.warnnote && cj.warnnote !== 'rgba(0, 0, 0, 0)', cj.warnnote);

  console.log('\n[6] 主题切换');
  const themeOk = await evalJs(`(function(){
    const before = getComputedStyle(document.body).backgroundColor;
    document.documentElement.setAttribute('data-theme','dark');
    const dark = getComputedStyle(document.body).backgroundColor;
    document.documentElement.setAttribute('data-theme','light');
    const light = getComputedStyle(document.body).backgroundColor;
    document.documentElement.removeAttribute('data-theme');
    return JSON.stringify({before, dark, light, differ: dark !== light});
  })()`);
  const tj = JSON.parse(themeOk || '{}');
  check('暗/亮背景不同', tj.differ === true, `${tj.dark} vs ${tj.light}`);

  console.log('\n[7] 用量页延迟渲染');
  await evalJs(`location.hash = '#/usage'`); await sleep(1600);
  const lazy = await evalJs(`(function(){
    const ds = document.querySelectorAll('details[data-lazy]');
    if (!ds.length) return JSON.stringify({n:0});
    const before = document.getElementById('view').querySelectorAll('*').length;
    const emptyBodies = [...ds].filter(d => { const b=d.querySelector('.lazy-body'); return b && b.innerHTML.trim()===''; }).length;
    ds[0].open = true;
    ds[0].dispatchEvent(new Event('toggle'));
    const after = document.getElementById('view').querySelectorAll('*').length;
    const filled = ds[0].querySelector('.lazy-body').innerHTML.length > 50;
    return JSON.stringify({n: ds.length, emptyBodies, before, after, filled});
  })()`);
  const lj = JSON.parse(lazy || '{}');
  check('存在延迟渲染表格', lj.n > 0, `${lj.n} 张`);
  check('收起时表体为空', lj.emptyBodies === lj.n, `${lj.emptyBodies}/${lj.n}`);
  check('展开后填充内容', lj.filled === true);
  check('展开后 DOM 才增长', lj.after > lj.before, `${lj.before} → ${lj.after}`);

  console.log('\n[8] 接入源虚拟滚动');
  await evalJs(`location.hash = '#/sources'`); await sleep(1600);
  const virt = await evalJs(`(function(){
    const vp = document.getElementById('srcListVp');
    const inner = document.getElementById('srcListInner');
    if (!vp || !inner) return JSON.stringify({ok:false});
    return JSON.stringify({ok:true, rows: inner.querySelectorAll(':scope > div').length,
      total: Math.round(parseFloat(inner.style.height)||0)});
  })()`);
  const vj = JSON.parse(virt || '{}');
  check('虚拟滚动生效', vj.ok === true && vj.rows < 80, `${vj.rows} 个可见行 / 总高 ${vj.total}px`);

  console.log('\n[9] 布局无溢出');
  const overflow = await evalJs(`JSON.stringify({
    docW: document.documentElement.scrollWidth,
    winW: window.innerWidth
  })`);
  const oj = JSON.parse(overflow || '{}');
  check('无横向溢出', oj.docW <= oj.winW + 2, `${oj.docW} vs ${oj.winW}`);

  console.log('\n[10] 截图');
  const shot = await send('Page.captureScreenshot', { format: 'png' });
  if (shot && shot.data) {
    require('fs').writeFileSync('C:/Users/liang.zhao/Downloads/网关项目/_e2e_after.png', Buffer.from(shot.data, 'base64'));
    console.log('  ✓ 已保存 _e2e_after.png');
  }

  console.log('\n[11] 真实用户操作序列（模拟点击/输入/滚动）');
  const ops = [];
  const opCheck = (name, ok, extra) => {
    ops.push({ name, ok });
    if (ok) console.log(`  ✓ ${name}${extra ? '  ' + extra : ''}`);
    else { fails.push('op:' + name); console.log(`  ✗ ${name}${extra ? '  ' + extra : ''}`); }
  };

  // 回到接入源页
  await evalJs(`location.hash = '#/sources'`); await sleep(1800);

  // 11.1 搜索框输入（真实用户打字）
  // ★ 搜索框没有 id，靠 .src-list-search 定位；触发入口是 srcQueryChanged（不是裸 input 事件）。
  const searchTyped = await evalJs(`(function(){
    const inp = document.querySelector('.src-list-search input');
    if (!inp) return JSON.stringify({ok:false, why:'找不到搜索框'});
    const before = document.getElementById('srcListInner').querySelectorAll(':scope > div').length;
    inp.value = 'accio';
    inp.dispatchEvent(new Event('input', {bubbles:true}));
    if (typeof srcQueryChanged === 'function') srcQueryChanged('accio');
    return JSON.stringify({ok:true, before});
  })()`);
  let st = JSON.parse(searchTyped || '{}');
  await sleep(900);
  const afterSearch = await evalJs(`(function(){
    const inner = document.getElementById('srcListInner');
    return inner ? inner.querySelectorAll(':scope > div').length : -1;
  })()`);
  opCheck('搜索输入生效', st.ok === true && afterSearch >= 0, `${st.before} → ${afterSearch} 行`);

  // 11.2 清空搜索（恢复）
  await evalJs(`(function(){
    const inp = document.querySelector('.src-list-search input');
    if (inp) { inp.value=''; inp.dispatchEvent(new Event('input',{bubbles:true})); }
    if (typeof srcQueryChanged === 'function') srcQueryChanged('');
  })()`);
  await sleep(800);

  // 11.3 滚动虚拟列表（用户滚轮）
  const scrolled = await evalJs(`(function(){
    const vp = document.getElementById('srcListVp');
    const inner = document.getElementById('srcListInner');
    if (!vp || !inner) return JSON.stringify({ok:false});
    const before = inner.querySelectorAll(':scope > div').length;
    vp.scrollTop = 800;
    if (typeof srcOnListScroll === 'function') srcOnListScroll();
    return JSON.stringify({ok:true, before, scrollTop: vp.scrollTop});
  })()`);
  let sj = JSON.parse(scrolled || '{}');
  await sleep(400);
  const rowsAfterScroll = await evalJs(`document.getElementById('srcListInner') ? document.getElementById('srcListInner').querySelectorAll(':scope > div').length : -1`);
  opCheck('滚动后仍保持虚拟化', sj.ok === true && rowsAfterScroll > 0 && rowsAfterScroll < 200, `${rowsAfterScroll} 行可见`);

  // 11.4 打开平台详情（点击左栏平台行 → 右侧详情栏渲染登录面板）
  // ★ 用户真实路径是 srcSelect(id)，不是 srcMgr（后者是 wb 加油站的成长菜单）。
  const drawer = await evalJs(`(function(){
    if (typeof srcSelect !== 'function') return JSON.stringify({ok:false, why:'无 srcSelect'});
    srcSelect('apk-accio');
    return JSON.stringify({ok:true, on: document.querySelectorAll('.src-row.on').length});
  })()`);
  let dj = JSON.parse(drawer || '{}');
  await sleep(1200);
  // ★ 判定口径：登录面板**内联在 .src-detail-col 里**（srcLoginBody 直接拼进详情栏），
  //   #authBox 只是 authStart 之后放结果/二维码的容器，初始就是空的。
  //   之前拿 #authBox.innerHTML 判「面板渲染」是错的，会误报。
  const detailLen = await evalJs(`(function(){
    const d = document.querySelector('.src-detail-col');
    return d ? d.innerHTML.length : -1;
  })()`);
  opCheck('点击平台行后渲染详情栏', dj.ok === true && Number(detailLen) > 500, `${detailLen} 字节`);

  // 11.5 校验 Accio 登录面板文案（跳转登录 + 站点 + 风险提示）
  const accioPanel = await evalJs(`(function(){
    const d = document.querySelector('.src-detail-col');
    if (!d) return JSON.stringify({ok:false});
    const t = d.textContent || '';
    return JSON.stringify({
      ok: true,
      hasAuthBtn: t.includes('打开授权页'),
      hasSite: t.includes('国际站') || t.includes('大陆站'),
      hasWarn: !!d.querySelector('.warnnote'),
      hasSliderHint: t.includes('滑块'),
      len: t.length,
    });
  })()`);
  let aj = JSON.parse(accioPanel || '{}');
  opCheck('Accio 面板有「打开授权页」', aj.hasAuthBtn === true);
  opCheck('Accio 面板标明站点', aj.hasSite === true, '国际站/大陆站');
  opCheck('Accio 面板有滑块警示', aj.hasWarn === true && aj.hasSliderHint === true);

  // 11.6 切到大陆站，确认文案跟着变（这一步最能证明站点区分真实生效）
  await evalJs(`(function(){ if (typeof srcSelect === 'function') srcSelect('apk-accio-cn'); })()`);
  await sleep(1000);
  const cnPanel = await evalJs(`(function(){
    const d = document.querySelector('.src-detail-col');
    if (!d) return JSON.stringify({ok:false});
    const t = d.textContent || '';
    return JSON.stringify({ok:true, hasCn: t.includes('大陆站'), hasIntl: t.includes('国际站')});
  })()`);
  let cj2 = JSON.parse(cnPanel || '{}');
  opCheck('大陆站面板标「大陆站」', cj2.ok === true && cj2.hasCn === true && cj2.hasIntl === false,
    `hasCn=${cj2.hasCn} hasIntl=${cj2.hasIntl}`);

  // 11.7 撤销选中（回到列表总览）
  await evalJs(`(function(){ if (typeof srcSelect === 'function') srcSelect(''); })()`);
  await sleep(400);

  console.log('\n[11b] 跨页面真实操作（其他视图的主路径）');

  // 模型开关：真实形态是详情栏里的 .sw 按钮（onclick=toggleModel），不是原生 checkbox。
  // 整个界面只有 1 个原生 checkbox（系统提示词覆盖），所以按 checkbox 找必然落空。
  await evalJs(`location.hash = '#/sources'`); await sleep(1600);
  await evalJs(`(function(){
    // 找一个有模型的平台，确保详情栏里有模型开关
    if (typeof srcSelect === 'function') srcSelect('apk-qoder');
  })()`);
  await sleep(1400);
  const modelToggle = await evalJs(`(function(){
    const sw = document.querySelector('.sw[onclick*="toggleModel"]');
    if (!sw) {
      const n = document.querySelectorAll('[onclick*="toggleModel"]').length;
      return JSON.stringify({ok:false, why:'没有模型开关，找到 ' + n + ' 个 toggleModel 入口'});
    }
    const before = sw.classList.contains('on');
    // 不真的点（会改上游配置）：只验证控件存在且状态可读
    return JSON.stringify({ok:true, before, hasHandler: sw.getAttribute('onclick').includes('toggleModel')});
  })()`);
  let mt = JSON.parse(modelToggle || '{}');
  opCheck('模型开关控件存在且可读状态', mt.ok === true && mt.hasHandler === true,
    mt.ok ? `当前=${mt.before ? 'on' : 'off'}` : mt.why);

  // 系统提示词覆盖 checkbox（唯一原生 checkbox）—— 验证它能读能改
  await evalJs(`location.hash = '#/runtime'`); await sleep(1600);
  const spCheckbox = await evalJs(`(function(){
    const cb = document.getElementById('spOverride');
    if (!cb) return JSON.stringify({ok:false, why:'没有 #spOverride'});
    const before = cb.checked;
    cb.click();
    const after = cb.checked;
    cb.click(); // 复原
    return JSON.stringify({ok:true, before, after});
  })()`);
  let sp = JSON.parse(spCheckbox || '{}');
  opCheck('系统提示词开关可切换', sp.ok === true && sp.before !== sp.after,
    sp.ok ? `${sp.before} → ${sp.after}` : sp.why);

  // 代理设置弹窗（真实用户会点）
  const proxyModal = await evalJs(`(async function(){
    if (typeof showProxySettings !== 'function') return JSON.stringify({ok:false, why:'无 showProxySettings'});
    await showProxySettings();
    return JSON.stringify({ok:true, masks: document.querySelectorAll('.modal-mask').length});
  })()`);
  let pm = JSON.parse(proxyModal || '{}');
  await sleep(800);
  const proxyHasInput = await evalJs(`(function(){
    const m = document.querySelector('.modal-mask');
    if (!m) return JSON.stringify({ok:false});
    return JSON.stringify({ok:true, inputs: m.querySelectorAll('input,select').length,
      hasProxyText: (m.textContent||'').includes('代理')});
  })()`);
  let ph = JSON.parse(proxyHasInput || '{}');
  opCheck('代理设置弹窗可打开且有表单', pm.ok === true && ph.ok === true && ph.inputs > 0,
    `masks=${pm.masks} inputs=${ph.inputs}`);
  // 关掉
  await evalJs(`(function(){
    document.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    document.querySelectorAll('.modal-mask').forEach(m=>m.remove());
  })()`);
  await sleep(400);

  // 日志页：重新加载
  await evalJs(`location.hash = '#/logs'`); await sleep(1600);
  const logPage = await evalJs(`(function(){
    const v = document.getElementById('view');
    if (!v) return JSON.stringify({ok:false});
    const before = v.innerHTML.length;
    if (typeof route === 'function') route();
    return JSON.stringify({ok:true, before, hasTable: !!v.querySelector('table, .log-row, .logs')});
  })()`);
  let lp = JSON.parse(logPage || '{}');
  await sleep(1200);
  const logAfter = await evalJs(`(document.getElementById('view')||{}).innerHTML ? document.getElementById('view').innerHTML.length : -1`);
  opCheck('日志页可重新加载', lp.ok === true && Number(logAfter) > 100, `${lp.before} → ${logAfter} 字节`);

  // 主题循环切换三次（暗/亮/跟随系统），每次都要真的变
  await evalJs(`location.hash = '#/overview'`); await sleep(1200);
  const themeCycle = await evalJs(`(function(){
    if (typeof cycleTheme !== 'function') return JSON.stringify({ok:false});
    const seen = [];
    for (let i = 0; i < 3; i++) {
      cycleTheme();
      seen.push(document.documentElement.getAttribute('data-theme') || 'auto');
    }
    return JSON.stringify({ok:true, seen});
  })()`);
  let tc = JSON.parse(themeCycle || '{}');
  await sleep(600);
  const themeDistinct = tc.ok && new Set(tc.seen).size >= 2;
  opCheck('主题循环有多种状态', themeDistinct === true, JSON.stringify(tc.seen));


  console.log('\n[12] 快速连点压力（防抖/竞态）');
  const rapid = await evalJs(`(function(){
    if (typeof srcRerender !== 'function') return JSON.stringify({ok:false});
    const t0 = performance.now();
    for (let i = 0; i < 12; i++) srcRerender();
    return JSON.stringify({ok:true, ms: Math.round(performance.now() - t0)});
  })()`);
  let rj = JSON.parse(rapid || '{}');
  opCheck('连续 12 次重渲染不崩', rj.ok === true && rj.ms < 3000, `${rj.ms}ms`);

  // ── 操作指标汇总（供 autoresearch 采集）──
  const opsPass = ops.filter((o) => o.ok).length;
  const opsPct = ops.length ? Math.round((opsPass / ops.length) * 1000) / 10 : 0;
  console.log('\n操作序列：' + opsPass + '/' + ops.length + ' 通过');
  ops.filter((o) => !o.ok).forEach((o) => console.log('  失败: ' + o.name));
  console.log('METRIC ops_pass_pct=' + opsPct);

  console.log('\nDOM 节点数汇总：');
  for (const [k, v] of Object.entries(domCounts)) console.log(`   ${k.padEnd(10)} ${v}`);

  console.log('\n' + (fails.length ? `✗ ${fails.length} 项失败：${fails.join(', ')}` : '✓ 全部通过'));
  ws.close();
  proc.kill();
  process.exit(fails.length ? 1 : 0);
}

main().catch((e) => { console.error('✗ 异常：', e && e.message); process.exit(1); });
